# Production Environment Variables Template
# Copy this file to .env and fill in your actual values

# GitHub Container Registry
GITHUB_USERNAME=your-github-username
IMAGE_TAG=latest  # Use specific tag in production (e.g., main-abc123 or v1.0.0)

# Database Configuration
DB_PASSWORD=change-this-to-a-secure-password

# Security
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-64-chars

# LLM Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Custom Provider Base URLs (for proxies or local endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Server Configuration
EXTERNAL_PORT=8080  # External port to expose the service

# Logging Level
# Options: error, warn, info, debug, trace
RUST_LOG=info,manti=info

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60  # Requests per minute

# Redis Configuration (if using cache profile)
REDIS_PASSWORD=change-this-redis-password

# Grafana Configuration (if using monitoring profile)
GRAFANA_PASSWORD=change-this-grafana-admin-password

# Deployment Notes:
# 1. Generate secure passwords:
#    - DB_PASSWORD: openssl rand -base64 32
#    - JWT_SECRET: openssl rand -base64 64
#    - REDIS_PASSWORD: openssl rand -base64 32
#    - GRAFANA_PASSWORD: openssl rand -base64 24
#
# 2. Run with specific profiles:
#    - Basic: docker-compose -f docker-compose.prod.yml up -d
#    - With SSL: docker-compose -f docker-compose.prod.yml --profile with-ssl up -d
#    - With Cache: docker-compose -f docker-compose.prod.yml --profile with-cache up -d
#    - With Monitoring: docker-compose -f docker-compose.prod.yml --profile monitoring up -d
#    - All features: docker-compose -f docker-compose.prod.yml --profile with-ssl --profile with-cache --profile monitoring up -d
#
# 3. Before deploying to production:
#    - Change all default passwords
#    - Use specific image tags instead of 'latest'
#    - Configure SSL/TLS (use the with-ssl profile)
#    - Set up proper backup strategy for postgres_data volume
#    - Configure log rotation
#    - Set up monitoring and alerting