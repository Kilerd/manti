# Docker Deployment Environment Variables

# JWT Secret - MUST CHANGE IN PRODUCTION!
JWT_SECRET=change-this-secret-key-in-production-use-a-long-random-string

# OpenAI Configuration (required if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration (required if using Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Logging level
RUST_LOG=info,manti=debug

# Database (only change if using external database)
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/manti