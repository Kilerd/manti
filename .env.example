# Server Configuration
MANTI_SERVER_HOST=127.0.0.1
MANTI_SERVER_PORT=8080

# Database Configuration
MANTI_DATABASE_URL=postgres://user:password@localhost/manti
MANTI_DATABASE_MAX_CONNECTIONS=10

# Authentication
MANTI_AUTH_JWT_SECRET=your-secret-key-here
MANTI_AUTH_JWT_EXPIRATION=86400

# OpenAI Provider (optional)
MANTI_PROVIDERS_OPENAI_API_KEY=sk-...
# MANTI_PROVIDERS_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Provider (optional)
MANTI_PROVIDERS_ANTHROPIC_API_KEY=sk-ant-...
# MANTI_PROVIDERS_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Provider (optional)
# MANTI_PROVIDERS_GOOGLE_API_KEY=...

# Logging
RUST_LOG=info,manti=debug